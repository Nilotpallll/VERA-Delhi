# ==============================================================================
# VERA Platform Environment Configuration Template
# Architecture Rule 11: Secrets must never be committed. Copy this file to .env.
# Architecture Rule 15: All dependencies support free/self-hosted tiers.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application & API
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
VERSION=1.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
API_KEY_SECRET=change-me-to-a-secure-random-secret-in-production

# ------------------------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VERA_API_URL=http://localhost:8000
NEXT_PUBLIC_VERA_API_VERSION=v1

# ------------------------------------------------------------------------------
# Supabase (PostgreSQL, pgvector, Supabase Auth, Supabase Storage)
# Architecture Rule 10: Persistent files must never depend on Render local disk.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vera_db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=evidence-vault

# ------------------------------------------------------------------------------
# Upstash (Redis, Ratelimit, QStash)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
UPSTASH_QSTASH_URL=https://qstash.upstash.io/v2
UPSTASH_QSTASH_TOKEN=your-upstash-qstash-token

# ------------------------------------------------------------------------------
# AI & LLM Providers (Architecture Rule 3 & Rule 15)
# ------------------------------------------------------------------------------
# Primary Cloud Provider: Google Gemini (Free tier)
GEMINI_API_KEY=your-gemini-free-tier-api-key

# Local / Self-Hosted Provider: Ollama (Zero API cost)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Optional Fast Provider: Groq (Free tier)
GROQ_API_KEY=your-groq-api-key

# ------------------------------------------------------------------------------
# Observability & Monitoring
# ------------------------------------------------------------------------------
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.1
